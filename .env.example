# =================================================================
# AI Interview Prep Kit - Environment Configuration Example
# =================================================================

# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai-interview-prep-kit

# Authentication & Security
# Used for signing JWT authentication tokens and session cookies
JWT_SECRET=replace_with_a_secure_random_string_in_production_min_32_chars
COOKIE_SECRET=replace_with_a_secure_cookie_secret_in_production
SESSION_MAX_AGE_DAYS=7

# Client Origin (CORS & Cookie SameSite)
FRONTEND_URL=http://localhost:3000

# LLM Provider Configuration
# Supported providers: "gemini" | "groq" | "openai" | "mock"
# - gemini: Uses Google Gemini API (Free tier available on Google AI Studio)
# - groq: Uses Groq API (High speed, generous free tier with Llama-3.3-70b)
# - openai: Compatible with OpenAI, OpenRouter, etc.
# - mock: Deterministic offline fixture provider (zero external API calls, used for tests)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your_gemini_api_key_here

# Crawler & Security Configuration
# Set ALLOW_LOCAL_CRAWL=true to allow testing on local test servers (e.g. http://localhost:8099/)
ALLOW_LOCAL_CRAWL=true
MAX_CRAWL_PAGES=5
CRAWL_TIMEOUT_MS=8000
MAX_PAGE_BYTES=1048576

# Pipeline Settings
MAX_COVERAGE_PASSES=3
